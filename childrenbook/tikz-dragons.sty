% tikz-dragons.sty — Reusable TikZ macros for Goldie and Draghino
% Two Beanie Boo-style dragon characters for the children's book
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tikz-dragons}[2026/03/15 Dragon character macros]

\RequirePackage{tikz}
\RequirePackage{xcolor}

\usetikzlibrary{calc, decorations.pathmorphing, patterns, shadows}

%% ========================================================
%% COLOR DEFINITIONS
%% ========================================================

% Goldie's palette
\definecolor{goldieBody}{RGB}{65, 125, 215}        % Sparkly blue
\definecolor{goldieBodyDark}{RGB}{45, 95, 180}      % Darker blue for shading
\definecolor{goldieBelly}{RGB}{200, 170, 50}        % Golden/metallic
\definecolor{goldieBellyLight}{RGB}{230, 200, 80}   % Light gold highlight
\definecolor{goldieEyeIris}{RGB}{200, 155, 25}      % Amber/gold iris
\definecolor{goldieEyeDark}{RGB}{160, 120, 10}      % Darker amber
\definecolor{goldieWings}{RGB}{25, 25, 35}          % Black wings
\definecolor{goldieNostril}{RGB}{240, 210, 40}      % Yellow nostril

% Draghino's palette
\definecolor{draghinoBody}{RGB}{235, 170, 200}      % Pastel pink
\definecolor{draghinoBodyDark}{RGB}{210, 140, 175}   % Darker pink
\definecolor{draghinoEyeIris}{RGB}{50, 185, 185}    % Teal/turquoise
\definecolor{draghinoEyeDark}{RGB}{30, 150, 150}    % Darker teal
\definecolor{draghinoHorns}{RGB}{100, 160, 230}     % Blue horns
\definecolor{draghinoWingBase}{RGB}{60, 60, 70}     % Dark wing base
\definecolor{draghinoWingTip}{RGB}{100, 160, 230}   % Blue wing tips
\definecolor{draghinoSnout}{RGB}{245, 220, 225}     % Light pink snout
\definecolor{draghinoSpotPurple}{RGB}{170, 120, 195}
\definecolor{draghinoSpotYellow}{RGB}{240, 220, 80}
\definecolor{draghinoSpotGreen}{RGB}{140, 210, 130}
\definecolor{draghinoSpotBlue}{RGB}{130, 170, 230}
\definecolor{draghinoSpotPink}{RGB}{245, 140, 170}
\definecolor{draghinoSpotOrange}{RGB}{240, 180, 100}

%% ========================================================
%% GOLDIE — Sparkly blue dragon with golden belly
%% ========================================================
%% Usage: \drawGoldie{x}{y}{scale}{facing}
%%   facing: 1 = right, -1 = left

\newcommand{\drawGoldie}[4]{%
  \begin{scope}[shift={(#1,#2)}, scale=#3, xscale=#4]
    %% --- TAIL ---
    \draw[goldieBody, fill=goldieBody, line width=0.5pt]
      (0.9, -0.6) .. controls (1.6, -0.5) and (2.0, -0.1) .. (2.2, 0.2)
      .. controls (2.1, 0.0) and (1.7, -0.3) .. (0.9, -0.4) -- cycle;
    % Tail tip
    \draw[goldieBodyDark, fill=goldieBodyDark]
      (2.2, 0.2) .. controls (2.35, 0.35) and (2.15, 0.45) .. (2.0, 0.3)
      .. controls (2.1, 0.15) and (2.15, 0.15) .. (2.2, 0.2);

    %% --- BACK LEGS ---
    \fill[goldieBody] (0.3, -1.2) ellipse (0.25 and 0.15);
    \fill[goldieBody] (0.7, -1.2) ellipse (0.25 and 0.15);
    % Toes
    \foreach \tx in {0.12, 0.3, 0.48} {
      \fill[goldieBodyDark] (\tx, -1.35) circle (0.05);
    }
    \foreach \tx in {0.52, 0.7, 0.88} {
      \fill[goldieBodyDark] (\tx, -1.35) circle (0.05);
    }

    %% --- BODY ---
    \fill[goldieBody] (0.5, -0.3) ellipse (0.85 and 0.9);

    %% --- BELLY ---
    % Scaled belly with hexagonal pattern suggestion
    \fill[goldieBelly] (0.5, -0.55) ellipse (0.5 and 0.65);
    % Scale pattern on belly
    \foreach \bx/\by in {0.35/-0.25, 0.65/-0.25, 0.5/-0.45, 0.35/-0.65, 0.65/-0.65, 0.5/-0.85, 0.35/-0.05, 0.65/-0.05} {
      \draw[goldieBellyLight, line width=0.3pt] (\bx, \by) circle (0.08);
    }

    %% --- FRONT LEGS ---
    \fill[goldieBody] (-0.05, -1.1) ellipse (0.2 and 0.18);
    \fill[goldieBody] (1.05, -1.1) ellipse (0.2 and 0.18);
    \foreach \tx in {-0.18, -0.05, 0.08} {
      \fill[goldieBodyDark] (\tx, -1.28) circle (0.04);
    }
    \foreach \tx in {0.92, 1.05, 1.18} {
      \fill[goldieBodyDark] (\tx, -1.28) circle (0.04);
    }

    %% --- WINGS (behind head) ---
    \fill[goldieWings]
      (0.0, 0.3) .. controls (-0.6, 1.2) and (-0.3, 1.6) .. (0.1, 1.3)
      .. controls (-0.1, 1.0) and (0.0, 0.7) .. (0.0, 0.3);
    \fill[goldieWings]
      (1.0, 0.3) .. controls (1.6, 1.2) and (1.3, 1.6) .. (0.9, 1.3)
      .. controls (1.1, 1.0) and (1.0, 0.7) .. (1.0, 0.3);

    %% --- HEAD ---
    \fill[goldieBody] (0.5, 0.55) circle (0.6);

    %% --- SNOUT ---
    \fill[goldieBodyDark] (0.5, 0.15) ellipse (0.3 and 0.15);

    %% --- NOSTRILS ---
    \fill[goldieNostril] (0.38, 0.18) circle (0.05);
    \fill[goldieNostril] (0.62, 0.18) circle (0.05);

    %% --- EYES (signature Beanie Boo oversized) ---
    % Left eye
    \fill[white] (0.22, 0.6) circle (0.26);
    \fill[goldieEyeIris] (0.22, 0.58) circle (0.22);
    \fill[goldieEyeDark] (0.22, 0.55) circle (0.15);
    \fill[black] (0.22, 0.54) circle (0.10);
    \fill[white] (0.28, 0.65) circle (0.06);
    \fill[white] (0.16, 0.50) circle (0.03);

    % Right eye
    \fill[white] (0.78, 0.6) circle (0.26);
    \fill[goldieEyeIris] (0.78, 0.58) circle (0.22);
    \fill[goldieEyeDark] (0.78, 0.55) circle (0.15);
    \fill[black] (0.78, 0.54) circle (0.10);
    \fill[white] (0.84, 0.65) circle (0.06);
    \fill[white] (0.72, 0.50) circle (0.03);

    %% --- SPARKLE ACCENTS ---
    \foreach \sx/\sy in {-0.1/0.3, 0.2/-0.1, 0.8/0.0, 1.1/0.2, 0.3/0.9, 0.7/0.95} {
      \draw[white, line width=0.4pt] (\sx-0.04, \sy) -- (\sx+0.04, \sy);
      \draw[white, line width=0.4pt] (\sx, \sy-0.04) -- (\sx, \sy+0.04);
    }

    %% --- MOUTH ---
    \draw[goldieBodyDark, line width=0.5pt]
      (0.4, 0.08) .. controls (0.5, 0.03) .. (0.6, 0.08);
  \end{scope}
}

%% ========================================================
%% GOLDIE FLYING POSE
%% ========================================================
\newcommand{\drawGoldieFlying}[4]{%
  \begin{scope}[shift={(#1,#2)}, scale=#3, xscale=#4]
    %% --- BODY (tilted) ---
    \begin{scope}[rotate=15]
      %% --- TAIL ---
      \draw[goldieBody, fill=goldieBody]
        (0.9, -0.4) .. controls (1.8, -0.2) and (2.2, 0.1) .. (2.4, 0.4)
        .. controls (2.2, 0.2) and (1.7, -0.1) .. (0.9, -0.2) -- cycle;

      %% --- BODY ---
      \fill[goldieBody] (0.5, -0.1) ellipse (0.75 and 0.7);

      %% --- BELLY ---
      \fill[goldieBelly] (0.5, -0.3) ellipse (0.4 and 0.5);

      %% --- WINGS EXTENDED ---
      \fill[goldieWings]
        (0.0, 0.3) .. controls (-1.2, 1.5) and (-1.8, 1.8) .. (-1.5, 1.0)
        .. controls (-1.2, 0.6) and (-0.5, 0.4) .. (0.0, 0.3);
      \fill[goldieWings]
        (1.0, 0.3) .. controls (2.2, 1.5) and (2.8, 1.8) .. (2.5, 1.0)
        .. controls (2.2, 0.6) and (1.5, 0.4) .. (1.0, 0.3);

      %% --- LEGS (tucked) ---
      \fill[goldieBody] (0.2, -0.75) ellipse (0.15 and 0.1);
      \fill[goldieBody] (0.8, -0.75) ellipse (0.15 and 0.1);
    \end{scope}

    %% --- HEAD ---
    \fill[goldieBody] (0.6, 0.65) circle (0.5);

    %% --- SNOUT ---
    \fill[goldieBodyDark] (0.6, 0.3) ellipse (0.25 and 0.12);
    \fill[goldieNostril] (0.5, 0.33) circle (0.04);
    \fill[goldieNostril] (0.7, 0.33) circle (0.04);

    %% --- EYES ---
    \fill[white] (0.38, 0.72) circle (0.22);
    \fill[goldieEyeIris] (0.38, 0.70) circle (0.18);
    \fill[black] (0.38, 0.68) circle (0.09);
    \fill[white] (0.43, 0.77) circle (0.05);

    \fill[white] (0.82, 0.72) circle (0.22);
    \fill[goldieEyeIris] (0.82, 0.70) circle (0.18);
    \fill[black] (0.82, 0.68) circle (0.09);
    \fill[white] (0.87, 0.77) circle (0.05);

    %% --- MOUTH ---
    \draw[goldieBodyDark, line width=0.4pt]
      (0.5, 0.23) .. controls (0.6, 0.19) .. (0.7, 0.23);
  \end{scope}
}

%% ========================================================
%% DRAGHINO — Pastel pink/rainbow dragon with teal eyes
%% ========================================================
\newcommand{\drawDraghino}[4]{%
  \begin{scope}[shift={(#1,#2)}, scale=#3, xscale=#4]
    %% --- TAIL ---
    \draw[draghinoBody, fill=draghinoBody]
      (0.9, -0.6) .. controls (1.5, -0.5) and (1.8, -0.2) .. (2.0, 0.1)
      .. controls (1.8, -0.1) and (1.5, -0.3) .. (0.9, -0.4) -- cycle;
    % Tail tip in blue
    \fill[draghinoHorns]
      (2.0, 0.1) .. controls (2.15, 0.25) and (1.95, 0.35) .. (1.85, 0.2)
      .. controls (1.9, 0.1) and (1.95, 0.08) .. (2.0, 0.1);

    %% --- BACK LEGS ---
    \fill[draghinoBody] (0.3, -1.2) ellipse (0.25 and 0.15);
    \fill[draghinoBody] (0.7, -1.2) ellipse (0.25 and 0.15);
    % Blue toes
    \foreach \tx in {0.12, 0.3, 0.48} {
      \fill[draghinoHorns] (\tx, -1.35) circle (0.05);
    }
    \foreach \tx in {0.52, 0.7, 0.88} {
      \fill[draghinoHorns] (\tx, -1.35) circle (0.05);
    }

    %% --- BODY ---
    \fill[draghinoBody] (0.5, -0.3) ellipse (0.85 and 0.9);

    %% --- MULTICOLOR SPOTS ---
    \fill[draghinoSpotPurple] (0.2, 0.1) circle (0.08);
    \fill[draghinoSpotPurple] (0.0, -0.2) circle (0.06);
    \fill[draghinoSpotPurple] (0.15, -0.5) circle (0.07);
    \fill[draghinoSpotYellow] (0.7, 0.15) circle (0.06);
    \fill[draghinoSpotYellow] (0.85, -0.3) circle (0.07);
    \fill[draghinoSpotGreen] (0.4, -0.8) circle (0.06);
    \fill[draghinoSpotGreen] (0.9, -0.6) circle (0.05);
    \fill[draghinoSpotBlue] (0.1, -0.8) circle (0.05);
    \fill[draghinoSpotBlue] (0.6, -0.5) circle (0.06);
    \fill[draghinoSpotPink] (0.8, 0.0) circle (0.07);
    \fill[draghinoSpotPink] (0.3, -0.3) circle (0.05);
    \fill[draghinoSpotOrange] (1.0, -0.1) circle (0.05);
    \fill[draghinoSpotOrange] (0.5, -0.6) circle (0.06);

    %% --- BELLY ---
    \fill[draghinoSnout] (0.5, -0.55) ellipse (0.45 and 0.55);

    %% --- FRONT LEGS ---
    \fill[draghinoBody] (-0.05, -1.1) ellipse (0.2 and 0.18);
    \fill[draghinoBody] (1.05, -1.1) ellipse (0.2 and 0.18);
    \foreach \tx in {-0.18, -0.05, 0.08} {
      \fill[draghinoHorns] (\tx, -1.28) circle (0.04);
    }
    \foreach \tx in {0.92, 1.05, 1.18} {
      \fill[draghinoHorns] (\tx, -1.28) circle (0.04);
    }

    %% --- WINGS ---
    % Left wing (dark base with blue tips)
    \fill[draghinoWingBase]
      (0.0, 0.3) .. controls (-0.5, 1.0) and (-0.3, 1.4) .. (0.0, 1.2)
      .. controls (-0.1, 0.9) and (0.0, 0.6) .. (0.0, 0.3);
    \fill[draghinoWingTip]
      (-0.3, 1.3) .. controls (-0.4, 1.5) and (-0.15, 1.55) .. (0.0, 1.2)
      .. controls (-0.1, 1.3) and (-0.2, 1.35) .. (-0.3, 1.3);
    % Right wing
    \fill[draghinoWingBase]
      (1.0, 0.3) .. controls (1.5, 1.0) and (1.3, 1.4) .. (1.0, 1.2)
      .. controls (1.1, 0.9) and (1.0, 0.6) .. (1.0, 0.3);
    \fill[draghinoWingTip]
      (1.3, 1.3) .. controls (1.4, 1.5) and (1.15, 1.55) .. (1.0, 1.2)
      .. controls (1.1, 1.3) and (1.2, 1.35) .. (1.3, 1.3);

    %% --- HEAD ---
    \fill[draghinoBody] (0.5, 0.55) circle (0.6);

    %% --- HEAD SPOTS ---
    \fill[draghinoSpotPurple] (0.15, 0.75) circle (0.06);
    \fill[draghinoSpotPurple] (0.85, 0.75) circle (0.06);
    \fill[draghinoSpotYellow] (0.3, 0.9) circle (0.04);
    \fill[draghinoSpotGreen] (0.7, 0.9) circle (0.04);
    \fill[draghinoSpotOrange] (0.5, 0.95) circle (0.05);

    %% --- HORNS (blue) ---
    \fill[draghinoHorns]
      (0.25, 1.0) -- (0.15, 1.4) -- (0.35, 1.05) -- cycle;
    \fill[draghinoHorns]
      (0.75, 1.0) -- (0.85, 1.4) -- (0.65, 1.05) -- cycle;
    % Middle small horn
    \fill[draghinoHorns]
      (0.5, 1.05) -- (0.5, 1.3) -- (0.55, 1.05) -- cycle;

    %% --- SNOUT ---
    \fill[draghinoSnout] (0.5, 0.2) ellipse (0.3 and 0.18);

    %% --- NOSTRILS ---
    \fill[draghinoBodyDark] (0.4, 0.2) circle (0.04);
    \fill[draghinoBodyDark] (0.6, 0.2) circle (0.04);

    %% --- EYES (signature Beanie Boo oversized) ---
    % Left eye
    \fill[white] (0.22, 0.6) circle (0.26);
    \fill[draghinoEyeIris] (0.22, 0.58) circle (0.22);
    \fill[draghinoEyeDark] (0.22, 0.55) circle (0.15);
    \fill[black] (0.22, 0.54) circle (0.10);
    \fill[white] (0.28, 0.65) circle (0.06);
    \fill[white] (0.16, 0.50) circle (0.03);

    % Right eye
    \fill[white] (0.78, 0.6) circle (0.26);
    \fill[draghinoEyeIris] (0.78, 0.58) circle (0.22);
    \fill[draghinoEyeDark] (0.78, 0.55) circle (0.15);
    \fill[black] (0.78, 0.54) circle (0.10);
    \fill[white] (0.84, 0.65) circle (0.06);
    \fill[white] (0.72, 0.50) circle (0.03);

    %% --- MOUTH ---
    \draw[draghinoBodyDark, line width=0.5pt]
      (0.4, 0.1) .. controls (0.5, 0.06) .. (0.6, 0.1);
  \end{scope}
}

%% ========================================================
%% DRAGHINO FLYING POSE
%% ========================================================
\newcommand{\drawDraghinoFlying}[4]{%
  \begin{scope}[shift={(#1,#2)}, scale=#3, xscale=#4]
    %% --- BODY (tilted) ---
    \begin{scope}[rotate=15]
      %% --- TAIL ---
      \draw[draghinoBody, fill=draghinoBody]
        (0.9, -0.4) .. controls (1.7, -0.2) and (2.0, 0.0) .. (2.2, 0.3)
        .. controls (2.0, 0.1) and (1.6, -0.1) .. (0.9, -0.2) -- cycle;
      \fill[draghinoHorns]
        (2.2, 0.3) .. controls (2.3, 0.45) and (2.1, 0.5) .. (2.0, 0.35)
        .. controls (2.1, 0.25) and (2.15, 0.25) .. (2.2, 0.3);

      %% --- BODY ---
      \fill[draghinoBody] (0.5, -0.1) ellipse (0.75 and 0.7);

      %% --- SPOTS ON BODY ---
      \fill[draghinoSpotPurple] (0.2, 0.2) circle (0.06);
      \fill[draghinoSpotYellow] (0.7, 0.1) circle (0.05);
      \fill[draghinoSpotGreen] (0.3, -0.4) circle (0.06);
      \fill[draghinoSpotBlue] (0.8, -0.3) circle (0.05);
      \fill[draghinoSpotPink] (0.5, -0.5) circle (0.05);

      %% --- BELLY ---
      \fill[draghinoSnout] (0.5, -0.3) ellipse (0.4 and 0.45);

      %% --- WINGS EXTENDED ---
      \fill[draghinoWingBase]
        (0.0, 0.3) .. controls (-1.0, 1.3) and (-1.6, 1.6) .. (-1.3, 0.8)
        .. controls (-1.0, 0.5) and (-0.4, 0.3) .. (0.0, 0.3);
      \fill[draghinoWingTip]
        (-1.4, 1.4) .. controls (-1.7, 1.7) and (-1.3, 1.75) .. (-1.0, 1.2)
        .. controls (-1.15, 1.35) and (-1.3, 1.4) .. (-1.4, 1.4);
      \fill[draghinoWingBase]
        (1.0, 0.3) .. controls (2.0, 1.3) and (2.6, 1.6) .. (2.3, 0.8)
        .. controls (2.0, 0.5) and (1.4, 0.3) .. (1.0, 0.3);
      \fill[draghinoWingTip]
        (2.4, 1.4) .. controls (2.7, 1.7) and (2.3, 1.75) .. (2.0, 1.2)
        .. controls (2.15, 1.35) and (2.3, 1.4) .. (2.4, 1.4);

      %% --- LEGS (tucked) ---
      \fill[draghinoBody] (0.2, -0.75) ellipse (0.15 and 0.1);
      \fill[draghinoBody] (0.8, -0.75) ellipse (0.15 and 0.1);
    \end{scope}

    %% --- HEAD ---
    \fill[draghinoBody] (0.6, 0.65) circle (0.5);
    \fill[draghinoSpotPurple] (0.35, 0.85) circle (0.04);
    \fill[draghinoSpotYellow] (0.85, 0.85) circle (0.04);

    %% --- HORNS ---
    \fill[draghinoHorns]
      (0.4, 1.0) -- (0.3, 1.3) -- (0.5, 1.05) -- cycle;
    \fill[draghinoHorns]
      (0.8, 1.0) -- (0.9, 1.3) -- (0.7, 1.05) -- cycle;

    %% --- SNOUT ---
    \fill[draghinoSnout] (0.6, 0.3) ellipse (0.25 and 0.12);
    \fill[draghinoBodyDark] (0.5, 0.33) circle (0.03);
    \fill[draghinoBodyDark] (0.7, 0.33) circle (0.03);

    %% --- EYES ---
    \fill[white] (0.38, 0.72) circle (0.22);
    \fill[draghinoEyeIris] (0.38, 0.70) circle (0.18);
    \fill[black] (0.38, 0.68) circle (0.09);
    \fill[white] (0.43, 0.77) circle (0.05);

    \fill[white] (0.82, 0.72) circle (0.22);
    \fill[draghinoEyeIris] (0.82, 0.70) circle (0.18);
    \fill[black] (0.82, 0.68) circle (0.09);
    \fill[white] (0.87, 0.77) circle (0.05);

    %% --- MOUTH ---
    \draw[draghinoBodyDark, line width=0.4pt]
      (0.5, 0.23) .. controls (0.6, 0.19) .. (0.7, 0.23);
  \end{scope}
}

\endinput
