%% --- COLLEGE COURTYARD ---
\newcommand{\drawCollegeCourtyard}{%
  % Sky
  \fill[skyBlue] (0,0) rectangle (8,8);
  \drawCloud{3}{7.2}{0.8}
  % College buildings (three sides of a quad)
  % Back wall
  \fill[stoneLt] (0, 4) rectangle (8, 6.5);
  \fill[roofDark] (0, 6.5) rectangle (8, 7);
