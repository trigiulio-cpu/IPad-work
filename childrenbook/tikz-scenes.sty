% tikz-scenes.sty — Reusable TikZ scene/background macros
% Rochester and Cambridge landmarks for the children's book
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tikz-scenes}[2026/03/15 Scene background macros]

\RequirePackage{tikz}
\RequirePackage{xcolor}

\usetikzlibrary{calc, decorations.pathmorphing, patterns}

