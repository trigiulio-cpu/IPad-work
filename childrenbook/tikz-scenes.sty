\definecolor{leafDark}{RGB}{45, 110, 40}
\definecolor{willowGreen}{RGB}{120, 180, 90}

%% ========================================================
%% UTILITY: Simple tree
%% ========================================================
\newcommand{\drawTree}[3]{%
  % #1=x, #2=y, #3=scale
  \begin{scope}[shift={(#1,#2)}, scale=#3]
    \fill[treeTrunk] (-0.08, 0) rectangle (0.08, 0.5);
    \fill[leafGreen] (0, 0.8) circle (0.35);
    \fill[leafDark] (0.05, 0.7) circle (0.25);
  \end{scope}
}

%% Willow tree for Cambridge
\newcommand{\drawWillow}[3]{%
  \begin{scope}[shift={(#1,#2)}, scale=#3]
    \fill[treeTrunk] (-0.1, 0) rectangle (0.1, 0.8);
    \fill[willowGreen] (0, 1.1) circle (0.5);
    % Drooping branches
    \foreach \wx in {-0.4, -0.2, 0.0, 0.2, 0.4} {
      \draw[willowGreen, line width=1.5pt]
        (\wx, 0.9) .. controls (\wx-0.1, 0.3) and (\wx+0.05, 0.1) .. (\wx, -0.1);
    }
  \end{scope}
}

%% Simple cloud
\newcommand{\drawCloud}[3]{%
  \begin{scope}[shift={(#1,#2)}, scale=#3]
    \fill[white, opacity=0.9] (0,0) circle (0.3);
    \fill[white, opacity=0.9] (0.25, 0.1) circle (0.35);
    \fill[white, opacity=0.9] (0.55, 0.05) circle (0.28);
    \fill[white, opacity=0.9] (0.15, -0.05) circle (0.25);
  \end{scope}
}

%% ========================================================
%% ROCHESTER SCENES
%% ========================================================

%% --- HIGH FALLS ---
\newcommand{\drawHighFalls}{%
  % Sky
  \fill[skyBlue] (0,0) rectangle (8,8);
  \fill[skyLight] (0,0) rectangle (8,3);
  % Clouds
  \drawCloud{1.5}{6.5}{1.2}
  \drawCloud{5.0}{7.0}{1.0}
  % Cliff walls
  \fill[stoneDark] (0, 0) rectangle (2.5, 5.5);
  \fill[stoneGray] (5.5, 0) rectangle (8, 5.5);
  % Cliff texture
  \foreach \cy in {1, 2, 3, 4, 5} {
    \draw[stoneLt, line width=0.3pt] (0.2, \cy) -- (2.3, \cy);
    \draw[stoneLt, line width=0.3pt] (5.7, \cy) -- (7.8, \cy);
  }
  % Waterfall
  \fill[waterLight, opacity=0.8] (2.5, 0) rectangle (5.5, 5.5);
  % Falling water streaks
  \foreach \wx in {2.8, 3.2, 3.6, 4.0, 4.4, 4.8, 5.2} {
    \draw[white, line width=2pt, opacity=0.6]
      (\wx, 5.5) -- (\wx + 0.1, 0.5);
  }
  % Mist at bottom
  \fill[white, opacity=0.5] (1.5, 0) ellipse (3.5 and 1.2);
  \fill[white, opacity=0.3] (4.0, 0.3) ellipse (2.5 and 0.8);
  % Water splash
  \foreach \sx in {2.5, 3.0, 3.5, 4.0, 4.5, 5.0} {
    \fill[white, opacity=0.7] (\sx, 0.2) circle (0.15);
  }
  % Bridge at top
  \fill[stoneDark] (2.0, 5.3) rectangle (6.0, 5.7);
  \fill[stoneGray] (2.0, 5.7) rectangle (6.0, 5.9);
  % Railing
  \foreach \rx in {2.2, 2.8, 3.4, 4.0, 4.6, 5.2, 5.8} {
    \fill[stoneDark] (\rx, 5.9) rectangle (\rx+0.1, 6.3);
  }
  \fill[stoneDark] (2.0, 6.3) rectangle (6.0, 6.45);
  % Trees on clifftops
  \drawTree{0.5}{5.5}{0.8}
  \drawTree{1.5}{5.5}{1.0}
  \drawTree{6.5}{5.5}{0.9}
  \drawTree{7.3}{5.5}{0.7}
}

%% --- STRONG MUSEUM (National Museum of Play) ---
\newcommand{\drawStrongMuseum}{%
  % Sky
  \fill[skyBlue] (0,0) rectangle (8,8);
  \drawCloud{1}{6.8}{1.0}
  \drawCloud{5.5}{7.2}{0.8}
  % Ground
  \fill[grassGreen] (0, 0) rectangle (8, 1.5);
  % Museum building — modern style with colorful panels
  \fill[stoneLt] (1.0, 1.5) rectangle (7.0, 5.5);
  % Colorful facade panels (playful museum)
  \fill[red!60] (1.2, 3.5) rectangle (2.5, 5.3);
  \fill[blue!50] (2.7, 3.5) rectangle (4.0, 5.3);
  \fill[green!50] (4.2, 3.5) rectangle (5.5, 5.3);
  \fill[yellow!60] (5.7, 3.5) rectangle (7.0, 5.3);
  % Windows in colored panels
  \foreach \wx in {1.6, 3.1, 4.6, 6.1} {
    \fill[white] (\wx, 4.0) rectangle (\wx+0.5, 4.8);
    \fill[skyLight] (\wx+0.05, 4.05) rectangle (\wx+0.45, 4.75);
  }
  % Entrance
  \fill[stoneDark] (3.2, 1.5) rectangle (4.8, 3.3);
  \fill[white] (3.4, 1.5) rectangle (4.6, 3.1);
  % Door
  \fill[brickRed] (3.6, 1.5) rectangle (4.4, 2.8);
  \fill[yellow!80!black] (4.2, 2.1) circle (0.06);
  % "STRONG" sign
  \node[white, font=\sffamily\bfseries\small] at (4.0, 5.0) {PLAY};
  % Butterfly decoration on building
  \fill[orange!70] (2.0, 5.0) -- (1.8, 5.3) -- (2.0, 5.15) -- (2.2, 5.3) -- cycle;
  % Path to entrance
  \fill[stoneGray] (3.5, 0) -- (4.5, 0) -- (4.6, 1.5) -- (3.4, 1.5) -- cycle;
  % Flowers along path
  \fill[red] (2.0, 1.6) circle (0.12); \fill[grassDark] (2.0, 1.3) rectangle (2.04, 1.6);
  \fill[yellow] (2.5, 1.6) circle (0.12); \fill[grassDark] (2.5, 1.3) rectangle (2.54, 1.6);
  \fill[purple] (5.5, 1.6) circle (0.12); \fill[grassDark] (5.5, 1.3) rectangle (5.54, 1.6);
  \fill[red] (6.0, 1.6) circle (0.12); \fill[grassDark] (6.0, 1.3) rectangle (6.04, 1.6);
  \fill[orange] (6.5, 1.6) circle (0.12); \fill[grassDark] (6.5, 1.3) rectangle (6.54, 1.6);
}

%% --- ROCHESTER SKYLINE (with Kodak Tower) ---
\newcommand{\drawRochesterSkyline}{%
  % Sunset sky
  \fill[skySunset] (0, 0) rectangle (8, 8);
  \fill[skyDawn] (0, 4) rectangle (8, 8);
  \fill[skyBlue!30!skyDawn] (0, 6) rectangle (8, 8);
  % Sun
  \fill[yellow!80, opacity=0.8] (6.5, 4.5) circle (0.8);
  \fill[yellow!50, opacity=0.3] (6.5, 4.5) circle (1.2);
  % Buildings silhouette
  % Kodak Tower (tallest, center-left)
  \fill[stoneDark!80!black] (2.0, 1.5) rectangle (3.0, 6.0);
  \fill[stoneDark!60!black] (2.2, 6.0) rectangle (2.8, 6.5);
  \fill[stoneDark!50!black] (2.35, 6.5) rectangle (2.65, 6.8);
  % Windows on Kodak Tower
  \foreach \wy in {2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0, 5.5} {
    \foreach \wxx in {2.2, 2.5, 2.8} {
      \fill[yellow!60, opacity=0.5] (\wxx-0.08, \wy) rectangle (\wxx+0.08, \wy+0.3);
    }
  }
  % Other buildings
  \fill[stoneDark!70!black] (0.5, 1.5) rectangle (1.8, 4.0);
  \fill[stoneDark!75!black] (3.2, 1.5) rectangle (4.2, 4.5);
  \fill[stoneDark!65!black] (4.4, 1.5) rectangle (5.2, 3.8);
  \fill[stoneDark!80!black] (5.4, 1.5) rectangle (6.3, 4.8);
  \fill[stoneDark!70!black] (6.5, 1.5) rectangle (7.5, 3.5);
  % Windows on other buildings
  \foreach \bx/\bw/\bh in {1.0/1.5/3.8, 3.5/4.0/4.3, 4.6/5.0/3.6, 5.6/6.1/4.6, 6.8/7.3/3.3} {
    \foreach \wy in {2.0, 2.6, 3.2} {
      \fill[yellow!50, opacity=0.4] (\bx, \wy) rectangle (\bx+0.15, \wy+0.3);
    }
  }
  % Ground / river
  \fill[grassDark] (0, 0) rectangle (8, 1.5);
  \fill[waterDark, opacity=0.6] (0, 0) rectangle (8, 0.8);
  % Reflection
  \fill[yellow!30, opacity=0.2] (2.0, 0) rectangle (3.0, 0.8);
}

%% --- GENESEE RIVER ---
\newcommand{\drawGeneseeRiver}{%
  % Sky
  \fill[skyBlue] (0,0) rectangle (8,8);
  \fill[skyLight] (0, 5) rectangle (8, 8);
  \drawCloud{1.0}{7.0}{1.0}
  \drawCloud{4.5}{6.5}{1.3}
  \drawCloud{6.5}{7.2}{0.7}
  % Distant hills
  \fill[grassDark!70!skyBlue] (0, 4.5) .. controls (2, 5.2) and (4, 4.8) .. (6, 5.0)
    .. controls (7, 5.1) and (7.5, 4.9) .. (8, 5.0) -- (8, 4) -- (0, 4) -- cycle;
  % Riverbanks
  \fill[grassGreen] (0, 0) .. controls (1, 2.5) and (2, 3.0) .. (3, 2.8)
    .. controls (4, 2.5) and (4.5, 2.0) .. (4, 1.5) -- (0, 1.5) -- cycle;
  \fill[grassGreen] (8, 0) .. controls (7, 2.5) and (6, 3.0) .. (5, 2.8)
    .. controls (4.5, 2.5) and (4, 2.0) .. (4.5, 1.5) -- (8, 1.5) -- cycle;
  % River
  \fill[waterBlue] (3, 2.8) .. controls (3.5, 3.5) and (4, 4.0) .. (4, 5.0)
    -- (4.5, 5.0) .. controls (4.5, 4.0) and (5, 3.5) .. (5, 2.8)
    -- (4.5, 1.5) -- (4, 1.5) -- cycle;
  % Water ripples
  \foreach \ry in {2.0, 2.8, 3.5, 4.2} {
    \draw[waterLight, line width=0.8pt] (3.5, \ry) .. controls (4.0, \ry+0.1) .. (4.5, \ry);
  }
  % Trees along banks
  \drawTree{0.5}{2.0}{0.7}
  \drawTree{1.5}{2.5}{0.9}
  \drawTree{2.3}{2.7}{0.8}
  \drawTree{5.8}{2.7}{0.8}
  \drawTree{6.5}{2.5}{0.9}
  \drawTree{7.3}{2.0}{0.7}
  % Autumn leaves (scattered dots)
  \fill[orange] (1, 3.5) circle (0.06);
  \fill[red] (1.5, 4) circle (0.06);
  \fill[yellow] (2, 3.2) circle (0.06);
  \fill[orange] (6, 3.5) circle (0.06);
  \fill[red] (6.8, 4) circle (0.06);
  \fill[yellow] (7, 3.0) circle (0.06);
  % Path along river
  \fill[stoneGray!50!grassGreen] (0, 1.5) .. controls (1.5, 2.0) and (2.5, 2.3) .. (3, 2.3)
    -- (3, 2.0) .. controls (2.5, 2.0) and (1.5, 1.7) .. (0, 1.2) -- cycle;
}

%% --- SNOW SCENE ---
\newcommand{\drawSnowScene}{%
  % Winter sky
  \fill[skyLight!80!white] (0,0) rectangle (8,8);
  % Snowflakes
  \foreach \sx/\sy in {0.5/7, 1.2/6.5, 2/7.3, 2.8/6, 3.5/7.5, 4.2/6.8, 5/7.2, 5.8/6.3, 6.5/7, 7.2/6.6, 1/5.5, 3/5, 5/5.5, 7/5, 0.8/4.5, 4/4, 6/4.5} {
    \fill[white] (\sx, \sy) circle (0.05);
    \draw[white, line width=0.3pt] (\sx-0.07, \sy) -- (\sx+0.07, \sy);
    \draw[white, line width=0.3pt] (\sx, \sy-0.07) -- (\sx, \sy+0.07);
  }
  % Snowy ground
  \fill[snowWhite] (0,0) rectangle (8, 2.5);
  \fill[snowShadow] (0, 0) .. controls (2, 0.3) and (4, 0.1) .. (6, 0.3)
    .. controls (7, 0.2) and (7.5, 0.4) .. (8, 0.2) -- (8, 0) -- cycle;
  % Snow hills
  \fill[snowWhite] (0, 2.5) .. controls (2, 3.2) and (3, 2.8) .. (4, 3.0)
    .. controls (5, 3.2) and (6, 2.7) .. (8, 3.0) -- (8, 2.5) -- cycle;
  % Bare trees
  \fill[treeTrunk] (1.0, 2.5) rectangle (1.15, 4.0);
  \draw[treeTrunk, line width=1.5pt] (1.07, 3.5) -- (0.7, 4.2);
  \draw[treeTrunk, line width=1.5pt] (1.07, 3.8) -- (1.5, 4.5);
  \draw[treeTrunk, line width=1pt] (1.07, 3.2) -- (0.8, 3.6);
  \fill[treeTrunk] (6.5, 2.7) rectangle (6.65, 4.3);
  \draw[treeTrunk, line width=1.5pt] (6.57, 3.8) -- (6.2, 4.5);
  \draw[treeTrunk, line width=1.5pt] (6.57, 4.0) -- (7.0, 4.6);
  \draw[treeTrunk, line width=1pt] (6.57, 3.4) -- (6.9, 3.8);
  % Snow on branches
  \fill[snowWhite] (0.65, 4.15) ellipse (0.15 and 0.06);
  \fill[snowWhite] (1.45, 4.45) ellipse (0.15 and 0.06);
  \fill[snowWhite] (6.15, 4.45) ellipse (0.15 and 0.06);
  \fill[snowWhite] (6.95, 4.55) ellipse (0.15 and 0.06);
}

%% --- COZY CAVE ---
\newcommand{\drawCozyCave}{%
  % Cave interior - dark background
  \fill[stoneDark!60!black] (0,0) rectangle (8,8);
  % Cave opening arch (lighter)
  \fill[skyLight] (0, 0) .. controls (0, 6) and (3, 8) .. (4, 8)
    .. controls (5, 8) and (8, 6) .. (8, 0) -- cycle;
  % Cave walls
  \fill[stoneDark] (0, 0) -- (0, 7) .. controls (1, 7.5) and (2, 7.8) .. (2.5, 7)
    -- (2.5, 0) -- cycle;
  \fill[stoneDark] (8, 0) -- (8, 7) .. controls (7, 7.5) and (6, 7.8) .. (5.5, 7)
    -- (5.5, 0) -- cycle;
  % Cave floor
  \fill[stoneDark!80!black] (0, 0) rectangle (8, 1.5);
  % Sparkly rocks
  \fill[yellow] (1, 0.5) circle (0.08); \fill[yellow, opacity=0.5] (1, 0.5) circle (0.12);
  \fill[yellow] (1.5, 0.3) circle (0.08); \fill[yellow, opacity=0.5] (1.5, 0.3) circle (0.12);
  \fill[yellow] (0.8, 1.0) circle (0.08); \fill[yellow, opacity=0.5] (0.8, 1.0) circle (0.12);
  \fill[yellow] (6.5, 0.4) circle (0.08); \fill[yellow, opacity=0.5] (6.5, 0.4) circle (0.12);
  \fill[yellow] (7, 0.8) circle (0.08); \fill[yellow, opacity=0.5] (7, 0.8) circle (0.12);
  \fill[yellow] (6.8, 0.2) circle (0.08); \fill[yellow, opacity=0.5] (6.8, 0.2) circle (0.12);
  % View through cave opening - sky and river
  \fill[grassGreen] (2.5, 0) rectangle (5.5, 2.0);
  \fill[waterBlue] (3.0, 0.5) .. controls (3.5, 0.8) and (4.5, 0.7) .. (5.0, 0.5)
    .. controls (4.5, 0.3) and (3.5, 0.4) .. (3.0, 0.5);
}

%% --- COLORFUL GARDEN ---
\newcommand{\drawGarden}{%
  % Sky
  \fill[skyBlue] (0,0) rectangle (8,8);
  \fill[skyLight] (0, 6) rectangle (8, 8);
  \drawCloud{2}{7}{0.8}
  \drawCloud{6}{7.3}{1.0}
  % Grass
  \fill[grassGreen] (0, 0) rectangle (8, 3);
  \fill[grassDark] (0, 0) rectangle (8, 1);
  % Flowers - lots of them in rainbow colors (front row)
  \foreach \fx/\fy/\fc in {0.5/2.8/red, 1.0/3.0/orange, 1.5/2.7/yellow,
    2.0/3.1/green, 2.5/2.9/blue, 3.0/2.8/purple,
    3.5/3.0/red, 4.0/2.7/pink, 4.5/3.1/orange,
    5.0/2.9/yellow, 5.5/2.8/blue, 6.0/3.0/purple,
    6.5/2.7/red, 7.0/3.1/pink, 7.5/2.9/orange} {
    \fill[grassDark] (\fx, 2.5) rectangle (\fx+0.03, \fy);
    \fill[\fc] (\fx, \fy) circle (0.13);
  }
  % More flowers in back row
  \foreach \fx/\fy/\fc in {0.8/3.4/pink, 1.8/3.5/yellow, 2.8/3.3/red,
    3.8/3.6/purple, 4.8/3.4/orange, 5.8/3.5/blue, 6.8/3.3/pink} {
    \fill[grassDark] (\fx, 3.0) rectangle (\fx+0.03, \fy);
    \fill[\fc] (\fx, \fy) circle (0.1);
  }
  % Butterfly
  \fill[orange!70] (5.0, 5.0) -- (4.8, 5.3) -- (5.0, 5.15) -- (5.2, 5.3) -- cycle;
  \fill[yellow!70] (5.0, 5.0) -- (4.85, 4.75) -- (5.0, 4.85) -- (5.15, 4.75) -- cycle;
  \fill[black] (5.0, 5.0) circle (0.03);
  % Fence in background
  \foreach \fxx in {0.3, 1.1, 1.9, 2.7, 3.5, 4.3, 5.1, 5.9, 6.7, 7.5} {
    \fill[woodBrown] (\fxx, 3.5) rectangle (\fxx+0.12, 4.5);
    \fill[woodBrown] (\fxx-0.03, 4.3) -- (\fxx+0.06, 4.6) -- (\fxx+0.15, 4.3) -- cycle;
  }
  \fill[woodBrown] (0.3, 3.9) rectangle (7.6, 4.05);
  \fill[woodBrown] (0.3, 4.2) rectangle (7.6, 4.35);
}

%% ========================================================
%% CAMBRIDGE SCENES
%% ========================================================

%% --- KING'S COLLEGE CHAPEL ---
\newcommand{\drawKingsCollege}{%
  % Sky
  \fill[skyBlue] (0,0) rectangle (8,8);
  \fill[skyLight] (0, 5) rectangle (8, 8);
  \drawCloud{1}{7}{1.0}
  \drawCloud{6}{7.3}{0.8}
  % Ground / lawn
  \fill[grassGreen] (0, 0) rectangle (8, 2.0);
  % Chapel building - Gothic style
  % Main body
  \fill[stoneLt] (1.5, 2.0) rectangle (6.5, 5.5);
  % Buttresses
  \foreach \bx in {1.8, 2.6, 3.4, 4.2, 5.0, 5.8} {
    \fill[stoneGray] (\bx, 2.0) rectangle (\bx+0.2, 5.8);
    % Pinnacles on buttresses
    \fill[stoneGray] (\bx-0.02, 5.8) -- (\bx+0.1, 6.3) -- (\bx+0.22, 5.8) -- cycle;
  }
  % Gothic windows (pointed arches)
  \foreach \wx in {2.0, 2.8, 3.6, 4.4, 5.2} {
    \fill[skyBlue!40!white] (\wx, 2.5) rectangle (\wx+0.4, 4.8);
    \fill[skyBlue!40!white] (\wx, 4.8) -- (\wx+0.2, 5.2) -- (\wx+0.4, 4.8) -- cycle;
    % Window tracery (vertical line)
    \draw[stoneLt, line width=0.5pt] (\wx+0.2, 2.5) -- (\wx+0.2, 5.1);
  }
  % Great west window (larger, center)
  % Roof line
  \fill[roofDark] (1.3, 5.5) -- (4.0, 6.8) -- (6.7, 5.5) -- cycle;
  % Tower at corner
  \fill[stoneLt] (1.0, 2.0) rectangle (1.8, 6.0);
  \fill[stoneGray] (0.95, 6.0) rectangle (1.85, 6.2);
  % Tower pinnacles
  \fill[stoneGray] (1.0, 6.2) -- (1.15, 6.8) -- (1.3, 6.2) -- cycle;
  \fill[stoneGray] (1.5, 6.2) -- (1.65, 6.8) -- (1.8, 6.2) -- cycle;
  % Second tower
  \fill[stoneLt] (6.2, 2.0) rectangle (7.0, 6.0);
  \fill[stoneGray] (6.15, 6.0) rectangle (7.05, 6.2);
  \fill[stoneGray] (6.2, 6.2) -- (6.35, 6.8) -- (6.5, 6.2) -- cycle;
  \fill[stoneGray] (6.7, 6.2) -- (6.85, 6.8) -- (7.0, 6.2) -- cycle;
  % Path to chapel
  \fill[stoneGray!80] (3.2, 0) -- (4.8, 0) -- (4.5, 2.0) -- (3.5, 2.0) -- cycle;
}

%% --- PUNTING ON THE CAM ---
\newcommand{\drawCamRiver}{%
  % Sky
  \fill[skyBlue] (0,0) rectangle (8,8);
  \fill[skyLight] (0, 6) rectangle (8, 8);
  \drawCloud{2}{7.2}{1.0}
  \drawCloud{5.5}{6.8}{0.8}
  % Riverbanks
  \fill[grassGreen] (0, 0) rectangle (2.5, 8);
  \fill[grassGreen] (5.5, 0) rectangle (8, 8);
  % River
  \fill[waterBlue] (2.5, 0) rectangle (5.5, 8);
  % Water reflections
  \foreach \ry in {0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5} {
