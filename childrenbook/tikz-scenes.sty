  \fill[black!50, opacity=0.6] (3.5, 2.5) rectangle (4.0, 4.5);
  \fill[black!50, opacity=0.6] (3.6, 4.5) rectangle (3.9, 4.8);
  % Other buildings
  \fill[black!50, opacity=0.5] (1, 2.5) rectangle (1.5, 3.8);
  \fill[black!50, opacity=0.5] (2, 2.5) rectangle (2.5, 3.5);
  \fill[black!50, opacity=0.5] (5, 2.5) rectangle (5.5, 3.6);
  \fill[black!50, opacity=0.5] (6, 2.5) rectangle (6.5, 3.3);
  % Hilltop (foreground)
  \fill[grassDark!80!black] (0, 0) .. controls (2, 2.5) and (6, 2.8) .. (8, 2.0)
    -- (8, 0) -- cycle;
  % Grass texture
  \foreach \gx in {0.5, 1.5, 2.5, 3.5, 5.0, 6.0, 7.0} {
    \pgfmathsetmacro{\gy}{0.3 + 2.0*\gx/8 + 0.3*sin(60*\gx)}
    \draw[grassDark!50!black, line width=0.5pt] (\gx, \gy) -- (\gx-0.1, \gy+0.3);
    \draw[grassDark!50!black, line width=0.5pt] (\gx, \gy) -- (\gx+0.1, \gy+0.25);
  }
}

%% --- RAINY WINDOW ---
\newcommand{\drawRainyWindow}{%
  % Room wall
  \fill[yellow!15!white] (0, 0) rectangle (8, 8);
  % Large window
  \fill[stoneLt] (1.0, 2.5) rectangle (7.0, 7.5);
  % Window panes showing grey rainy sky
  \fill[stoneGray!50!skyLight] (1.2, 2.7) rectangle (3.9, 7.3);
  \fill[stoneGray!50!skyLight] (4.1, 2.7) rectangle (6.8, 7.3);
  % Window frame cross
  \fill[stoneLt] (3.9, 2.5) rectangle (4.1, 7.5);
  \fill[stoneLt] (1.0, 5.0) rectangle (7.0, 5.2);
  % Rain streaks on window
  \foreach \rx/\ry in {1.5/7.0, 2.0/6.5, 2.5/7.2, 3.0/6.0, 3.5/7.0, 4.5/6.8, 5.0/7.0, 5.5/6.3, 6.0/7.1, 6.5/6.5} {
    \draw[waterBlue!50!white, line width=0.8pt, opacity=0.6]
      (\rx, \ry) .. controls (\rx-0.05, \ry-0.5) and (\rx+0.05, \ry-1.0) .. (\rx, \ry-1.5);
  }
  % Window sill
  \fill[stoneLt] (0.8, 2.3) rectangle (7.2, 2.7);
  % Floor
  \fill[woodBrown!30!white] (0, 0) rectangle (8, 2.3);
  % Cushion on window sill
  \fill[red!40] (2.5, 2.3) ellipse (1.5 and 0.4);
}

