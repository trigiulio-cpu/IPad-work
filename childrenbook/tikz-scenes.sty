  \foreach \wx in {0.5, 1.3, 2.1, 5.0, 5.8, 6.6} {
    \fill[white] (\wx, 4.8) rectangle (\wx+0.45, 5.8);
    \fill[skyLight] (\wx+0.05, 4.85) rectangle (\wx+0.4, 5.75);
  }
  \foreach \wx in {0.5, 1.3, 2.1, 5.0, 5.8, 6.6} {
    \fill[white] (\wx, 4.0) rectangle (\wx+0.45, 4.5);
  }
