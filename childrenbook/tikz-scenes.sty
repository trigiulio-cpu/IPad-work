%% SHARED COLORS
%% ========================================================
\definecolor{skyBlue}{RGB}{135, 190, 240}
\definecolor{skyLight}{RGB}{180, 215, 250}
\definecolor{skyDawn}{RGB}{250, 200, 140}
\definecolor{skySunset}{RGB}{240, 150, 100}
\definecolor{skyNight}{RGB}{20, 25, 60}
\definecolor{skyNightMid}{RGB}{35, 45, 90}
\definecolor{grassGreen}{RGB}{90, 170, 80}
\definecolor{grassDark}{RGB}{60, 130, 55}
\definecolor{waterBlue}{RGB}{80, 150, 210}
\definecolor{waterLight}{RGB}{140, 195, 235}
\definecolor{waterDark}{RGB}{50, 110, 170}
\definecolor{stoneGray}{RGB}{160, 160, 155}
\definecolor{stoneDark}{RGB}{120, 120, 115}
\definecolor{stoneLt}{RGB}{195, 195, 190}
\definecolor{brickRed}{RGB}{160, 75, 60}
\definecolor{roofDark}{RGB}{80, 70, 65}
\definecolor{snowWhite}{RGB}{240, 245, 250}
\definecolor{snowShadow}{RGB}{200, 215, 230}
